# Local data directory. Defaults to ./data.
SOLOTRACE_DATA_DIR=

# Cap untrusted uploads before decoding.
SOLOTRACE_MAX_UPLOAD_MB=250

# Optional outside macOS. macOS reads service com.ezracerpac.solotrace, account mvsep,
# from Keychain when this variable is absent.
SOLOTRACE_MVSEP_API_TOKEN=
SOLOTRACE_MVSEP_API_BASE_URL=https://de.mvsep.com/api
